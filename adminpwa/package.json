{
  "name": "ankhang-management-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-pwa.mjs && node scripts/check-build.mjs",
    "prepare:assets": "node scripts/build-pwa.mjs --assets",
    "preview": "vite preview --host 127.0.0.1",
    "verify:electron": "node scripts/initialize-port.mjs --verify",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.97.0",
    "html-to-image": "^1.11.13",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "esbuild": "^0.27.7",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
